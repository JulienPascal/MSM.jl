# Jupyter autosave copies
.ipynb_checkpoints/

# Folder of the economic models: only the notebooks and the Project.toml of their environment are
# tracked (not the Manifest, the Python environment created by CondaPkg, the data written by the
# notebooks, or working copies). Add a "!" line for each new notebook to track.
notebooks/models/*
!notebooks/models/Project.toml
!notebooks/models/RBC.ipynb
# Dynare.jl notebook, in its own environment: everything is tracked except the data written by the
# notebook, including the Manifest (it records the versions of the dependencies that work with
# Dynare.jl 0.10.4)
!notebooks/models/dynare/
notebooks/models/dynare/fake_data_RBC.csv
!notebooks/models/dynare/Manifest.toml

# Local helper to re-run all the notebooks, and its logs
notebooks/run_all_notebooks.sh
notebooks/run_logs/

# Figures and tables written by the notebooks
notebooks/**/*.png
notebooks/**/*.csv

# Documentation built by Documenter.jl (the published site is on the gh-pages branch)
docs/build/
